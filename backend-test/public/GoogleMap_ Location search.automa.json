ocations\n    });\n    automaNextBlock();\n  })\n  .catch((error) => {\n    console.error('Error:', error);\n    automaNextBlock();\n  });\n","preloadScripts":[],"everyNewTab":false,"runBeforeLoad":false,"onError":{"dataToInsert":[],"enable":false,"insertData":false,"retry":false,"retryInterval":2,"retryTimes":1,"toDo":"continue"},"settings":{"blockTimeout":0,"debugMode":false}},"label":"javascript-code"},{"id":"x141302","type":"BlockPackage","initialized":false,"position":{"x":1020,"y":495},"data":{"content":null,"createdAt":1748066243034,"data":{"edges":[{"class":"connected-edges","data":{},"id":"vueflow__edge-55lezny55lezny-output-gawP-ERueCXCrjtlGTiQU-k8ufri3k8ufri3-input-1","label":"","markerEnd":"arrowclosed","selectable":true,"source":"55lezny","sourceHandle":"55lezny-output-gawP-ERueCXCrjtlGTiQU","sourceX":656,"sourceY":568.296865609976,"target":"k8ufri3","targetHandle":"k8ufri3-input-1","targetX":771.0000375600962,"targetY":429.4999624399038,"type":"custom","updatable":true},{"class":"connected-edges","data":{},"id":"vueflow__edge-55lezny55lezny-output-fallback-9g8kg7o9g8kg7o-input-1","label":"","markerEnd":"arrowclosed","selectable":true,"source":"55lezny","sourceHandle":"55lezny-output-fallback","sourceX":654.9999624399038,"sourceY":610.2968468299279,"target":"9g8kg7o","targetHandle":"9g8kg7o-input-1","targetX":1115.9999436598557,"targetY":665.9999718299279,"type":"custom","updatable":true},{"class":"connected-edges","data":{},"id":"vueflow__edge-k8ufri3k8ufri3-output-1-9g8kg7o9g8kg7o-input-1","label":"","markerEnd":"arrowclosed","selectable":true,"source":"k8ufri3","sourceHandle":"k8ufri3-output-1","sourceX":1074.9999624399038,"sourceY":429.4999624399038,"target":"9g8kg7o","targetHandle":"9g8kg7o-input-1","targetX":1115.9999436598557,"targetY":665.9999718299279,"type":"custom","updatable":true}],"nodes":[{"data":{"blocks":[{"data":{"code":"let HtmlSource = document.documentElement.outerHTML\nautomaSetVariable('HtmlSource', HtmlSource)\nautomaNextBlock()"